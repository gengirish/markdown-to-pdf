{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=pdf-cert-generator",
  "devCommand": "npm run dev --workspace=pdf-cert-generator",
  "outputDirectory": "apps/legacy-web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://certforge-api.fly.dev/api/:path*"
    },
    {
      "source": "/certificate/:path*",
      "destination": "https://certforge-api.fly.dev/certificate/:path*"
    },
    {
      "source": "/invoice/:path*",
      "destination": "https://certforge-api.fly.dev/invoice/:path*"
    },
    {
      "source": "/verify/:path*",
      "destination": "https://certforge-api.fly.dev/verify/:path*"
    },
    {
      "source": "/credentials/:path*",
      "destination": "https://certforge-api.fly.dev/credentials/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://certforge-api.fly.dev/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://certforge-api.fly.dev/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://certforge-api.fly.dev/openapi.json"
    },
    {
      "source": "/llms.txt",
      "destination": "https://certforge-api.fly.dev/llms.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "https://certforge-api.fly.dev/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://certforge-api.fly.dev/sitemap.xml"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://certforge-api.fly.dev/.well-known/:path*"
    },
    {
      "source": "/((?!assets/|branding/).*)",
      "destination": "/index.html"
    }
  ]
}
