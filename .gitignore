# Local databases. test_db.sqlite was listed by name, so any other scratch
# database — an ad-hoc e2e run, a migration rehearsal — slipped straight past.
*.sqlite
*.sqlite3
*.db

/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# Secrets. Broad on purpose: the repo is public, and only `.env` and anything
# ending in `.local` used to be covered — so .env.production, prod.env and
# secrets.env would all have been committable. Examples are re-admitted below.
.env
.env.*
*.env
!.env.example
!*.env.example

.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing
# pytest builds apps/api/test_db.sqlite from scratch on every run (see
# apps/api/tests/conftest.py) — it is a build artifact, not fixture data.
apps/api/test_db.sqlite
.pytest_cache/
# Scratch PDFs only. `*.pdf` used to be blanket-ignored here, which also hid
# any PDF fixture added under apps/api/tests/ — the same class of bug as the
# unanchored `lib/` rule that swallowed apps/web/lib/. check_tracked_sources.py
# now covers binary fixtures too, so this staying narrow is enforced.
/tmp-*.pdf
/test_output.pdf
# Local reference documents. The repo is public and these are real business
# paperwork, not fixtures — kept on disk, never committed.
/docs/samples/Example_Invoice_For_Reference_Only.pdf
# Playwright output. Anchored to the root until a run from apps/api dropped a
# test-results/ there that the root-only pattern did not match.
test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Vercel
.vercel

# Local duplicate; canonical sample is docs/samples/IntelliForge_Internship_Offer_Letter.docx
/IntelliForge_Internship_Offer_Letter.docx

# Agent worktrees created by Claude Code (git worktrees live here).
.claude/worktrees/
.turbo/
