# CertForge — Environment Variables
# Copy to .env and fill in values

# ─── Core ──────────────────────────────────────────────────────────
# HMAC-SHA256 signing secret (REQUIRED in production)
CERT_SECRET_KEY=your-secret-key-here

# Rotated secret keys for key rotation (comma-separated, optional)
# CERT_ROTATED_SECRET_KEYS=old-key-1,old-key-2

# Environment: "production" or omit for dev
# ENV=production

# ─── Database ─────────────────────────────────────────────────────
# Neon PostgreSQL connection string (REQUIRED)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Authentication (Clerk) ───────────────────────────────────────
# Clerk publishable key (frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (backend JWT verification)
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (org sync)
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Email (AgentMail) ────────────────────────────────────────────
AGENTMAIL_API_KEY=am_...
AGENTMAIL_INBOX_ID=support@intelliforge.tech

# ─── Object storage (Cloudflare R2) — template artwork ───────────
# Where an uploaded certificate design is kept. Without all of these the
# template-artwork upload endpoint answers 503 and says so; there is
# deliberately no local-filesystem fallback, because a storage backend that
# differs between dev and production loses every image on a machine that
# scales to zero.
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=certforge-template-assets
# Only for a local MinIO or another S3-compatible store:
# R2_ENDPOINT=http://localhost:9000

# ─── Anthropic (reading an uploaded certificate design) ──────────
# Powers "place the fields for me" on a traced template. Unset means that one
# button answers 503; uploading a design and placing the fields by hand still
# works, which is why this is a gate and not a boot requirement.
# Each call costs roughly $0.05-0.20, so it is metered per org per month.
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_IMPORTS_PER_MONTH=10

# ─── Payments (Razorpay) — Phase 2 ───────────────────────────────
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# ─── API Keys ─────────────────────────────────────────────────────
# Comma-separated API keys for legacy certificate creation endpoint
# CERT_API_KEYS=key1,key2

# Admin key for legacy admin endpoints
# ADMIN_KEY=your-admin-key

# ─── Branding ─────────────────────────────────────────────────────
SITE_URL=https://certs.intelliforge.tech
CONTACT_EMAIL=support@intelliforge.tech
FOUNDER_NAME=Girish Hiremath
FOUNDER_TITLE=Founder, Intelliforge AI
CERT_BRAND_NAME=IntelliForge Learning
CERT_ORG_TAGLINE=AN INTELLIFORGE AI INITIATIVE
CERT_PARTICIPATION_TITLE=Certificate of Participation
CERT_ISSUED_BY=IntelliForge Learning
CERT_WEBSITE=learning.intelliforge.tech
