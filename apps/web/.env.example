# CertForge dashboard (apps/web) — copy to .env.local and fill in.

# Base URL of the CertForge API. Defaults to the production host when unset.
# Point this at http://localhost:8000 to develop against a local API.
NEXT_PUBLIC_CERTFORGE_API_URL=https://api.certforge.intelliforge.tech

# Clerk. Without these the app builds, but nobody can sign in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
