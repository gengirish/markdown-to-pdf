# CertForge dashboard (apps/web) — copy to .env.local and fill in.

# Base URL of the CertForge API. Point this at http://localhost:8000 to develop
# against a local API.
#
# NOTE: api.certforge.intelliforge.tech does NOT resolve yet — the Fly
# certificate exists but the DNS record has not been added, so copying the
# commented line below verbatim gives you a dashboard that cannot reach the API.
# The Vercel deployment uses certs.intelliforge.tech, which is what this file
# names until that lands. See docs/TODOs/certforge-api-host-missing.md.
NEXT_PUBLIC_CERTFORGE_API_URL=https://certs.intelliforge.tech
# NEXT_PUBLIC_CERTFORGE_API_URL=https://api.certforge.intelliforge.tech   # once DNS lands

# Clerk. Without these the app builds, but nobody can sign in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
